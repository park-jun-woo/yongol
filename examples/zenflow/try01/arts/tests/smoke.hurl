# Auto-generated by yongol generate. Regenerate with: yongol generate <specs> <arts>
# Run: hurl --test --variable host=http://localhost:8080 smoke.hurl
# Requires hurl 4+ for {{newUuid}} template variables used in auth fixtures.


# ===== Auth =====
# Signup
POST {{host}}/auth/signup
Content-Type: application/json
[Options]
variable: smoke_email=smoke-{{newUuid}}@example.com
{"credits_balance":1,"email":"{{smoke_email}}","name":"test","org_name":"test","password":"Password1234!","plan_type":"free"}
HTTP 200
[Captures]
token: jsonpath "$.access_token"

# Login
POST {{host}}/auth/login
Content-Type: application/json
{"email":"{{smoke_email}}","password":"Password1234!"}
HTTP 200
[Captures]
token: jsonpath "$.access_token"


# ===== CRUD =====
# CreateWorkflow
POST {{host}}/workflows
Authorization: Bearer {{token}}
Content-Type: application/json
{"title":"test","trigger_event":"test"}
HTTP 200
[Captures]
workflow_id: jsonpath "$.workflow.id"
[Asserts]
jsonpath "$.workflow" exists

# AddAction
POST {{host}}/workflows/{{workflow_id}}/actions
Authorization: Bearer {{token}}
Content-Type: application/json
{"action_type":"test","payload_template":"test","sequence_order":1}
HTTP 200
[Captures]
action_id: jsonpath "$.action.id"
[Asserts]
jsonpath "$.action" exists

# ActivateWorkflow
POST {{host}}/workflows/{{workflow_id}}/activate
Authorization: Bearer {{token}}
HTTP 200

# ExecuteWorkflow
POST {{host}}/workflows/{{workflow_id}}/execute
Authorization: Bearer {{token}}
HTTP 200


# ===== Reads =====
# ListWorkflows
GET {{host}}/workflows
Authorization: Bearer {{token}}
HTTP 200
[Asserts]
jsonpath "$.workflows" exists

# GetCurrentUser
GET {{host}}/users/me
Authorization: Bearer {{token}}
HTTP 200
[Asserts]
jsonpath "$.user" exists
